{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "noImplicitAny": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"]
  },
  "include": [
    "flutcom.config.js",
    "flutcom/**/*",
    "plugins/**/*",
    "types/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "assets/vendor",
    "create-flutcom"
  ]
}
